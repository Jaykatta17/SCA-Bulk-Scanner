# Copy to .env and adjust as needed. All values here have sane defaults in
# docker-compose.yml if you don't create a .env file at all.

# Host port the web UI/API is published on.
APP_PORT=8080

# MongoDB database name used for scan history.
MONGO_DB=sca_scanner

# Max scans run concurrently. Each concurrent scan gets host_cpus/this many
# CPUs (see webapp/backend/app/scanner.py) so raising it lowers per-scan
# throughput; keep it modest on small hosts.
MAX_CONCURRENT_SCANS=2
